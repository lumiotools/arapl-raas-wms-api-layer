{
    "batch_job_id": "input.batch_job_id",
    "batch_priority": "input.batch_priority",
    "batch_type": "input.batch_type",
    "batch_frequency": "null",
    "warehouse_id": "null",
    "tasks": {
        "source": "input.tasks",
        "map": {
                "task_id": "op.task_id",
                "task_type": "op.type",
                "task_pallet_id": "op.task_pallet_id",
                "task_dependency": "null",

                "start_location": {
                    "location_id": "op.start_location.location_id",
                    "location_action": "op.start_location.location_action",
                    "location_zone": "op.start_location.location_zone",
                    "location_dimension": {
                        "length": "op.start_location.location_dimension.length",
                        "width": "op.start_location.location_dimension.width",
                        "height": "op.start_location.location_dimension.height"
                    },
                    "location_attribute": {
                        "attribute_name": "null",
                        "attribute_value": "null"
                    }
                },

                "end_location": {
                    "location_id": "op.end_location.location_id",
                    "location_action": "op.end_location.location_action",
                    "location_zone": "op.end_location.location_zone",
                    "location_dimension": {
                        "length": "op.end_location.location_dimension.length",
                        "width": "op.end_location.location_dimension.width",
                        "height": "op.end_location.location_dimension.height"
                    },
                    "location_attribute": {
                        "attribute_name": "null",
                        "attribute_value": "null"
                    }
                },

                "wait_time": {
                    "wait_type": "null",
                    "start_location_wait_time": "null",
                    "end_location_wait_time": "null"
                },

                "cargo_code": "op.code",
                "cargo_type": "op.cargo_type",
                "cargo_dimension": {
                    "length": "op.cargo_dimension.length",
                    "width": "op.cargo_dimension.width",
                    "height": "op.cargo_dimension.height"
                },
                "cargo_weight": "op.weight",
                "cargo_attributes": {
                    "attribute_name": "op.attributes.name",
                    "attribute_value": "op.attributes.value"
                },


                "cargos":{
                "source": "op.cargos",
                "map": {
                        "cargo_code": "item.cargo_code",
                        "cargo_type": "item.cargo_type",
                        "cargo_dimension": {
                            "length": "item.cargo_dimension.length",
                            "width": "item.cargo_dimension.width",
                            "height": "item.cargo_dimension.height"
                        },
                        "cargo_weight": "item.cargo_weight",
                        "cargo_attributes":{
                            "attribute_name": "null",
                            "attribute_value": "null"
                        }
                    }
                }
            }
        }
}
