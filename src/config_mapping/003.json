{
    "batch_job_id": "input.job_id",
    "batch_priority": "input.job_priority",
    "batch_type": "input.job_type",
    "batch_frequency": "input.job_frequency",
    "warehouse_id": "null",
    "tasks": {
        "source": "input.job_tasks",
        "map": {
                "task_id": "op.id",
                "task_type": "op.type",
                "task_pallet_id": "null",
                "task_dependency": "op.depends_on",

                "start_location": {
                    "location_id": "op.source_location.id",
                    "location_action": "op.source_location.action",
                    "location_zone": "null",
                    "location_dimension": {
                        "length": "op.source_location.dimensions.len",
                        "width": "op.source_location.dimensions.wid",
                        "height": "op.source_location.dimensions.ht"
                    },
                    "location_attribute": {
                        "attribute_name": "op.source_location.attributes.name",
                        "attribute_value": "op.source_location.attributes.value"
                    }
                },

                "end_location": {
                    "location_id": "op.destination_location.id",
                    "location_action": "op.destination_location.action",
                    "location_zone": "null",
                    "location_dimension": {
                        "length": "op.destination_location.dimensions.len",
                        "width": "op.destination_location.dimensions.wid",
                        "height": "op.destination_location.dimensions.ht"
                    },
                    "location_attribute": {
                        "attribute_name": "null",
                        "attribute_value": "null"
                    }
                },

                "wait_time": {
                    "wait_type": "op.wait_config.type",
                    "start_location_wait_time": "op.wait_config.source_wait",
                    "end_location_wait_time": "op.wait_config.destination_wait"
                },

                "cargo_code": "op.code",
                "cargo_type": "op.cargo_type",
                "cargo_dimension": {
                    "length": "op.cargo_dimension.len",
                    "width": "op.cargo_dimension.wid",
                    "height": "op.cargo_dimension.ht"
                },
                "cargo_weight": "op.weight",
                "cargo_attributes": {
                    "attribute_name": "op.attributes.name",
                    "attribute_value": "op.attributes.value"
                },


                "cargos":{
                "source": "op.cargo_items",
                "map": {
                        "cargo_code": "item.code",
                        "cargo_type": "item.type",
                        "cargo_dimension": {
                            "length": "item.dimensions.len",
                            "width": "item.dimensions.wid",
                            "height": "item.dimensions.ht"
                        },
                        "cargo_weight": "item.weight",
                        "cargo_attributes":{
                            "attribute_name": "item.attributes.name",
                            "attribute_value": "item.attributes.value"
                        }
                    }
                }
            }
        }
}
